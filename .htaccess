# Filet de sécurité : si DocumentRoot n'est PAS pointé sur public/,
# on redirige toutes les requêtes vers public/ pour ne rien casser.
#
# Configuration recommandée : pointer le DocumentRoot de MAMP/XAMPP/Apache
# directement sur Projet-ABS/public/ (voir README.md).

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteRule ^$ public/ [L]
</IfModule>

# Empêche l'exposition directe des fichiers sensibles à la racine.
<FilesMatch "^(\.htaccess|\.gitignore|composer\.(json|lock)|README\.md|CHANGELOG\.md|LICENSE)$">
    Require all denied
</FilesMatch>

Options -Indexes
